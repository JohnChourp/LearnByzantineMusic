{
  "schema_version": 2,
  "skill_name": "learn-byzantine-android-release",
  "execution_mode": "local",
  "supported_os": [
    "macos",
    "linux"
  ],
  "unsupported_behavior": "fail_fast",
  "preflight": {
    "cache_ttl_seconds": 600,
    "checks": [
      {
        "type": "tool",
        "name": "bash",
        "install_hint": {
          "default": "Install bash and ensure it is in PATH."
        }
      },
      {
        "type": "tool",
        "name": "git",
        "install_hint": {
          "default": "Install Git and ensure it is in PATH."
        }
      }
    ]
  },
  "tooling": {
    "bash": {
      "macos": [
        "bash"
      ],
      "linux": [
        "bash"
      ]
    },
    "git": {
      "macos": [
        "git"
      ],
      "linux": [
        "git"
      ]
    }
  },
  "default_command": "run-release",
  "commands": [
    {
      "name": "run-release",
      "description": "Run the LearnByzantineMusic release workflow",
      "kind": "shell",
      "path": "scripts/run_release.sh",
      "args": []
    }
  ]
}
