  "second": {
   "hymns": [
    {"code": "01", "service": "vespers", "group": "kekragarion", "incipit": "Κύριε ἐκέκραξα πρὸς σέ, εἰσάκουσόν μου"},
    {"code": "02", "service": "vespers", "group": "stichera_anastasima", "incipit": "Τὸν πρὸ αἰώνων ἐκ Πατρὸς γεννηθέντα"},
    {"code": "03", "service": "vespers", "group": "stichera_anastasima", "incipit": "Χριστὸς ὁ Σωτὴρ ἡμῶν"},
    {"code": "04", "service": "vespers", "group": "stichera_anastasima", "incipit": "Σὺν Ἀρχαγγέλοις ὑμνήσωμεν"},
    {"code": "05", "service": "vespers", "group": "anatolika", "incipit": "Σὲ τὸν σταυρωθέντα καὶ ταφέντα"},
    {"code": "06", "service": "vespers", "group": "anatolika", "incipit": "Ἐν τῷ Σταυρῷ σου κατήργησας"},
    {"code": "07", "service": "vespers", "group": "anatolika", "incipit": "Ἠνοίγησάν σοι Κύριε"},
    {"code": "08", "service": "vespers", "group": "anatolika", "incipit": "Τὸν σωτήριον ὕμνον ᾄδοντες"},
    {"code": "09", "service": "vespers", "group": "dogmatikon", "incipit": "Παρῆλθεν ἡ σκιὰ τοῦ νόμου"},
    {"code": "10", "service": "vespers", "group": "aposticha", "incipit": "Ἡ Ἀνάστασίς σου Χριστὲ Σωτήρ"},
    {"code": "11", "service": "vespers", "group": "aposticha", "incipit": "Διὰ ξύλου Σῶτερ κατήργησας"},
    {"code": "12", "service": "vespers", "group": "aposticha", "incipit": "Ἐν τῷ Σταυρῷ Χριστέ"},
    {"code": "13", "service": "vespers", "group": "aposticha", "incipit": "Ζωοδότα Χριστέ, ἑκουσίως Πάθος ὑποστὰς διὰ θνητούς"},
    {"code": "14", "service": "vespers", "group": "aposticha", "incipit": "Ὢ θαύματος καινοῦ"},
    {"code": "15", "service": "vespers", "group": "apolytikion", "incipit": "Ὅτε κατῆλθες πρὸς τὸν θάνατον"},
    {"code": "16", "service": "vespers", "group": "apolytikion", "incipit": "Πάντα ὑπὲρ ἔννοιαν"},
    {"code": "17", "service": "orthros", "group": "kathismata", "incipit": "Ὁ εὐσχήμων Ἰωσήφ"},
    {"code": "18", "service": "orthros", "group": "kathismata", "incipit": "Ταῖς μυροφόροις Γυναιξί"},
    {"code": "19", "service": "orthros", "group": "kathismata", "incipit": "Ὑπερδεδοξασμένη ὑπάρχεις, Θεοτόκε Παρθένε"},
    {"code": "20", "service": "orthros", "group": "kathismata", "incipit": "Τὸν λίθον τοῦ μνήματος"},
    {"code": "21", "service": "orthros", "group": "kathismata", "incipit": "Τῶν Μαθητῶν σου ὁ χορός"},
    {"code": "22", "service": "orthros", "group": "kathismata", "incipit": "Ὑπερευλογημένη ὑπάρχεις, Θεοτόκε Παρθένε"},
    {"code": "23", "service": "orthros", "group": "ypakoe", "incipit": "Μετὰ τὸ Πάθος πορευθεῖσαι ἐν τῷ μνήματι πρὸς τὸ μυρίσαι τὸ"},
    {"code": "24", "service": "orthros", "group": "anavathmoi", "incipit": "Ἐν τῷ οὐρανῷ τὰ ὄμματα"},
    {"code": "25", "service": "orthros", "group": "anavathmoi", "incipit": "Εἰ μὴ ὅτι Κύριος ἦν ἐν ἡμῖν"},
    {"code": "26", "service": "orthros", "group": "anavathmoi", "incipit": "Οἱ πεποιθότες ἐπὶ Κύριον"},
    {"code": "27", "service": "orthros", "group": "prokeimenon", "incipit": "Ἐξεγέρθητι, Κύριε ὁ Θεός μου"},
    {"code": "28", "service": "orthros", "group": "heirmoi", "incipit": "Ἐν βυθῷ κατέστρωσέ ποτε"},
    {"code": "29", "service": "orthros", "group": "heirmoi", "incipit": "Ἐξήνθησεν ἡ ἔρημος"},
    {"code": "30", "service": "orthros", "group": "heirmoi", "incipit": "Ἐλήλυθας, ἐκ Παρθένου οὐ πρέσβυς οὐκ Ἄγγελος"},
    {"code": "31", "service": "orthros", "group": "heirmoi", "incipit": "Μεσίτης Θεοῦ, καὶ ἀνθρώπων γέγονας"},
    {"code": "32", "service": "orthros", "group": "heirmoi", "incipit": "Ἐν ἀβύσσῳ πταισμάτων κυκλούμενος"},
    {"code": "33", "service": "orthros", "group": "heirmoi", "incipit": "Ἀντίθεον πρόσταγμα, παρανομοῦντος τυράννου"},
    {"code": "34", "service": "orthros", "group": "heirmoi", "incipit": "Κάμινός ποτε, πυρὸς ἐν Βαβυλῶνι"},
    {"code": "35", "service": "orthros", "group": "heirmoi", "incipit": "Ἀνάρχου Γεννήτορος, Υἱὸς Θεὸς καὶ Κύριος"},
    {"code": "36", "service": "orthros", "group": "kontakion", "incipit": "Ἀνέστης Σωτήρ, ἐκ τάφου Παντοδύναμε καὶ ᾍδης ἰδών"},
    {"code": "37", "service": "orthros", "group": "ainoi_anastasima", "incipit": "Πᾶσα πνοή, καὶ πᾶσα κτίσις"},
    {"code": "38", "service": "orthros", "group": "ainoi_anastasima", "incipit": "Εἰπάτωσαν Ἰουδαῖοι, πῶς οἱ στρατιῶται ἀπώλεσαν τηροῦντες τὸν"},
    {"code": "39", "service": "orthros", "group": "ainoi_anastasima", "incipit": "Χαίρετε λαοί, καὶ ἀγαλλιᾶσθε"},
    {"code": "40", "service": "orthros", "group": "ainoi_anastasima", "incipit": "Ἄγγελος μὲν τὸ Χαῖρε"},
    {"code": "41", "service": "orthros", "group": "ainoi_anatolika", "incipit": "Ἔρραναν μύρα μετὰ δακρύων"},
    {"code": "42", "service": "orthros", "group": "ainoi_anatolika", "incipit": "Αἰνεσάτωσαν ἔθνη καὶ λαοὶ Χριστὸν τὸν Θεὸν ἡμῶν"},
    {"code": "43", "service": "orthros", "group": "ainoi_anatolika", "incipit": "Ἐσταυρώθης, ἐτάφης, Χριστέ"},
    {"code": "44", "service": "orthros", "group": "ainoi_anatolika", "incipit": "Ὄντως παράνομοι σφραγίσαντες τὸν λίθον"},
    {"code": "45", "service": "liturgy", "group": "makarismoi", "incipit": "Τὴν φωνήν σοι προσάγομεν"}
