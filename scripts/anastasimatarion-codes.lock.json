   "retired": []
  },
  "plagal_fourth": {
   "hymns": [
    {"code": "01", "service": "vespers", "group": "kekragarion", "incipit": "Κύριε ἐκέκραξα πρὸς σέ, εἰσάκουσόν μου"},
    {"code": "02", "service": "vespers", "group": "stichera_anastasima", "incipit": "Ἑσπερινὸν ὕμνον, καὶ λογικὴν λατρείαν"},
    {"code": "03", "service": "vespers", "group": "stichera_anastasima", "incipit": "Κύριε, Κύριε, μὴ ἀπορρίψῃς ἡμᾶς ἀπὸ τοῦ προσώπου σου"},
    {"code": "04", "service": "vespers", "group": "stichera_anastasima", "incipit": "Χαῖρε Σιὼν ἁγία"},
    {"code": "05", "service": "vespers", "group": "anatolika", "incipit": "Ὁ ἐκ Θεοῦ Πατρὸς Λόγος"},
    {"code": "06", "service": "vespers", "group": "anatolika", "incipit": "Τὴν ἐκ νεκρῶν σου Ἀνάστασιν"},
    {"code": "07", "service": "vespers", "group": "anatolika", "incipit": "Δόξα σοι Χριστὲ Σωτήρ"},
    {"code": "08", "service": "vespers", "group": "anatolika", "incipit": "Σὲ δοξάζομεν Κύριε"},
    {"code": "09", "service": "vespers", "group": "dogmatikon", "incipit": "Ὁ Βασιλεὺς τῶν οὐρανῶν"},
    {"code": "10", "service": "vespers", "group": "aposticha", "incipit": "Ἀνῆλθες ἐπὶ Σταυροῦ Ἰησοῦ"},
    {"code": "11", "service": "vespers", "group": "aposticha", "incipit": "Χριστὸν δοξολογήσωμεν, τὸν ἀναστάντα ἐκ νεκρῶν∙ ψυχὴν καὶ"},
    {"code": "12", "service": "vespers", "group": "aposticha", "incipit": "Ψαλμοῖς καὶ ὕμνοις δοξολογοῦμεν Χριστέ"},
    {"code": "13", "service": "vespers", "group": "aposticha", "incipit": "Ὦ Δέσποτα τῶν ἁπάντων"},
    {"code": "14", "service": "vespers", "group": "aposticha", "incipit": "Ἀνύμφευτε Παρθένε, ἡ τὸν Θεὸν ἀφράστως συλλαβοῦσα σαρκί"},
    {"code": "15", "service": "vespers", "group": "apolytikion", "incipit": "Ἐξ ὕψους κατῆλθες ὁ εὔσπλαγχνος"},
    {"code": "16", "service": "vespers", "group": "apolytikion", "incipit": "Ὁ δι' ἡμᾶς γεννηθεὶς ἐκ Παρθένου"},
    {"code": "17", "service": "orthros", "group": "kathismata", "incipit": "Ἀνέστης ἐκ νεκρών"},
    {"code": "18", "service": "orthros", "group": "kathismata", "incipit": "Ἀναστὰς ἐκ τοῦ τάφου ὡς ἀληθῶς"},
    {"code": "19", "service": "orthros", "group": "kathismata", "incipit": "Τὴν οὐράνιον πύλην καὶ κιβωτόν"},
    {"code": "20", "service": "orthros", "group": "kathismata", "incipit": "Ἄνθρωποι τὸ μνῆμά σου"},
    {"code": "21", "service": "orthros", "group": "kathismata", "incipit": "Τὰ μύρα τῆς ταφῆς"},
    {"code": "22", "service": "orthros", "group": "kathismata", "incipit": "Ἐπὶ σοὶ χαίρει"},
    {"code": "23", "service": "orthros", "group": "ypakoe", "incipit": "Αἱ Μυροφόροι τοῦ Ζωοδότου ἐπιστᾶσαι τῷ μνήματι"},
    {"code": "24", "service": "orthros", "group": "anavathmoi", "incipit": "Ἐκ νεότητός μου ὁ ἐχθρός με πειράζει"},
    {"code": "25", "service": "orthros", "group": "anavathmoi", "incipit": "Ἡ καρδία μου τῷ φόβῳ σου σκεπέσθω"},
    {"code": "26", "service": "orthros", "group": "anavathmoi", "incipit": "Ἐκέκραξά σοι Κύριε"},
    {"code": "27", "service": "orthros", "group": "anavathmoi", "incipit": "Ἰδοὺ δὴ τί καλόν"},
    {"code": "28", "service": "orthros", "group": "prokeimenon", "incipit": "Βασιλεύσει Κύριος εἰς τὸν αἰῶνα"},
    {"code": "29", "service": "orthros", "group": "heirmoi", "incipit": "Ἁρματηλάτην Φαραὼ ἐβύθισε"},
    {"code": "30", "service": "orthros", "group": "heirmoi", "incipit": "Ὁ στερεώσας κατ' ἀρχάς"},
    {"code": "31", "service": "orthros", "group": "heirmoi", "incipit": "Σύ μου ἰσχύς"},
    {"code": "32", "service": "orthros", "group": "heirmoi", "incipit": "Ἵνα τί με ἀπώσω"},
    {"code": "33", "service": "orthros", "group": "heirmoi", "incipit": "Ἱλάσθητί μοι Σωτήρ"},
    {"code": "34", "service": "orthros", "group": "heirmoi", "incipit": "Θεοῦ συγκατάβασιν, τὸ πῦρ ᾑδέσθη ἐν Βαβυλῶνί ποτε"},
    {"code": "35", "service": "orthros", "group": "heirmoi", "incipit": "Ἑπταπλασίως κάμινον, τῶν Χαλδαίων ὁ Τύραννος"},
    {"code": "36", "service": "orthros", "group": "heirmoi", "incipit": "Ἐξέστη ἐπὶ τούτῳ ὁ οὐρανός"},
    {"code": "37", "service": "orthros", "group": "kontakion", "incipit": "Ἐξαναστὰς τοῦ μνήματος"},
    {"code": "38", "service": "orthros", "group": "ainoi_anastasima", "incipit": "Κύριε, εἰ καὶ κριτηρίῳ παρέστης"},
    {"code": "39", "service": "orthros", "group": "ainoi_anastasima", "incipit": "Κύριε, εἰ καὶ ὡς νεκρὸν ἐν μνημείῳ"},
    {"code": "40", "service": "orthros", "group": "ainoi_anastasima", "incipit": "Κύριε, ὅπλον κατὰ τοῦ διαβόλου"},
    {"code": "41", "service": "orthros", "group": "ainoi_anastasima", "incipit": "Ὁ Ἄγγελός σου Κύριε"},
    {"code": "42", "service": "orthros", "group": "ainoi_anatolika", "incipit": "Ἔπαθες διὰ σταυροῦ"},
    {"code": "43", "service": "orthros", "group": "ainoi_anatolika", "incipit": "Προσκυνῶ καὶ δοξάζω"},
    {"code": "44", "service": "orthros", "group": "ainoi_anatolika", "incipit": "Τὸ ζωοδόχον σου μνῆμα"},
    {"code": "45", "service": "orthros", "group": "ainoi_anatolika", "incipit": "Πορευθέντος σου ἐν πύλαις ᾍδου Κύριε"},
    {"code": "46", "service": "liturgy", "group": "makarismoi", "incipit": "Μνήσθητι ἡμῶν, Χριστὲ Σωτὴρ τοῦ κόσμου ὥσπερ τοῦ Λῃστοῦ"}
   ],
