   "hymns": [
    {"code": "01", "service": "vespers", "group": "kekragarion", "incipit": "Κύριε ἐκέκραξα πρὸς σέ, εἰσάκουσόν μου"},
    {"code": "02", "service": "vespers", "group": "stichera_anastasima", "incipit": "Τῷ σῷ σταυρῷ Χριστὲ Σωτήρ"},
    {"code": "03", "service": "vespers", "group": "stichera_anastasima", "incipit": "Πεφώτισται τὰ σύμπαντα"},
    {"code": "04", "service": "vespers", "group": "stichera_anastasima", "incipit": "Δοξάζω τοῦ Πατρός"},
    {"code": "05", "service": "vespers", "group": "anatolika", "incipit": "Τὸν Σταυρόν σου τὸν τίμιον"},
    {"code": "06", "service": "vespers", "group": "anatolika", "incipit": "Ὑμνοῦμεν τὸν Σωτῆρα"},
    {"code": "07", "service": "vespers", "group": "anatolika", "incipit": "Τοῖς ἐν ᾅδῃ καταβὰς Χριστὸς εὐηγγελίσατο"},
    {"code": "08", "service": "vespers", "group": "anatolika", "incipit": "Οἱ ἀναξίως ἑστῶτες"},
    {"code": "09", "service": "vespers", "group": "dogmatikon", "incipit": "Πῶς μὴ θαυμάσωμεν"},
    {"code": "10", "service": "vespers", "group": "aposticha", "incipit": "Ὁ τῷ πάθει σου Χριστέ"},
    {"code": "11", "service": "vespers", "group": "aposticha", "incipit": "Ἡ ζωοδόχος σου Ἔγερσις Κύριε"},
    {"code": "12", "service": "vespers", "group": "aposticha", "incipit": "Θεὸς ὑπάρχων ἀναλλοίωτος"},
    {"code": "13", "service": "vespers", "group": "aposticha", "incipit": "Ἵνα τὸ γένος ἡμῶν"},
    {"code": "14", "service": "vespers", "group": "aposticha", "incipit": "Ἀσπόρως ἐκ θείου Πνεύματος"},
    {"code": "15", "service": "vespers", "group": "apolytikion", "incipit": "Εὐφραινέσθω τὰ οὐράνια"},
    {"code": "16", "service": "vespers", "group": "apolytikion", "incipit": "Σὲ τὴν μεσιτεύσασαν τὴν σωτηρίαν τοῦ γένους ἡμῶν"},
    {"code": "17", "service": "orthros", "group": "kathismata", "incipit": "Χριστὸς ἐκ νεκρῶν ἐγήγερται"},
    {"code": "18", "service": "orthros", "group": "kathismata", "incipit": "Σαρκὶ τοῦ θανάτου γευσάμενος Κύριε"},
    {"code": "19", "service": "orthros", "group": "kathismata", "incipit": "Τὴν ὡραιότητα, τῆς παρθενίας σου"},
    {"code": "20", "service": "orthros", "group": "kathismata", "incipit": "Τὸ ἀναλλοίωτον τὸ τῆς Θεότητος"},
    {"code": "21", "service": "orthros", "group": "kathismata", "incipit": "Τὸ ἀκατάληπτον τὸ τῆς Σταυρώσεως"},
    {"code": "22", "service": "orthros", "group": "kathismata", "incipit": "Τὸν ἀκατάληπτον καὶ ἀπερίγραπτον"},
    {"code": "23", "service": "orthros", "group": "ypakoe", "incipit": "Ἐκπλήττων τῇ ὁράσει"},
    {"code": "24", "service": "orthros", "group": "anavathmoi", "incipit": "Τὴν αἰχμαλωσίαν Σιών"},
    {"code": "25", "service": "orthros", "group": "anavathmoi", "incipit": "Ἐὰν μὴ Κύριος οἰκοδομήσῃ οἶκον τῶν ἀρετῶν"},
    {"code": "26", "service": "orthros", "group": "anavathmoi", "incipit": "Οἱ φοβούμενοι τὸν Κύριον"},
    {"code": "27", "service": "orthros", "group": "prokeimenon", "incipit": "Εἴπατε ἐν τοῖς ἔθνεσιν"},
    {"code": "28", "service": "orthros", "group": "heirmoi", "incipit": "Ὁ τὰ ὕδατα πάλαι"},
    {"code": "29", "service": "orthros", "group": "heirmoi", "incipit": "Ὁ ἐκ μὴ ὄντων τὰ πάντα παραγαγών"},
    {"code": "30", "service": "orthros", "group": "heirmoi", "incipit": "Ἔθου πρὸς ἡμᾶς"},
    {"code": "31", "service": "orthros", "group": "heirmoi", "incipit": "Πρὸς σε ὀρθρίζω"},
    {"code": "32", "service": "orthros", "group": "heirmoi", "incipit": "Ἄβυσσος ἐσχάτη ἁμαρτιῶν ἐκύκλωσέ με"},
    {"code": "33", "service": "orthros", "group": "heirmoi", "incipit": "Ὡς πάλαι τοὺς εὐσεβεῖς"},
    {"code": "34", "service": "orthros", "group": "heirmoi", "incipit": "Ἀστέκτῳ πυρὶ ἑνωθέντες"},
    {"code": "35", "service": "orthros", "group": "heirmoi", "incipit": "Καινὸν τὸ θαῦμα καὶ θεοπρεπές"},
    {"code": "36", "service": "orthros", "group": "kontakion", "incipit": "‘Εξανέστης σήμερον, ἀπὸ τοῦ τάφου Οἰκτίρμον"},
    {"code": "37", "service": "orthros", "group": "ainoi_anastasima", "incipit": "Δεῦτε πάντα τὰ ἔθνη"},
    {"code": "38", "service": "orthros", "group": "ainoi_anastasima", "incipit": "Διηγήσαντο πάντα τὰ θαυμάσια"},
    {"code": "39", "service": "orthros", "group": "ainoi_anastasima", "incipit": "Χαρᾶς τὰ πάντα πεπλήρωται"},
    {"code": "40", "service": "orthros", "group": "ainoi_anastasima", "incipit": "Ἐν τῷ φωτί σου Δέσποτα"},
    {"code": "41", "service": "orthros", "group": "ainoi_anatolika", "incipit": "Ὕμνον ἑωθινόν, αἱ Μυροφόροι Γυναῖκες"},
    {"code": "42", "service": "orthros", "group": "ainoi_anatolika", "incipit": "Ἐξαστράπτων Ἄγγελος, ἐπὶ τὸ μνῆμά σου τὸ ζωοποιόν"},
    {"code": "43", "service": "orthros", "group": "ainoi_anatolika", "incipit": "Εἰς τὸ μνῆμά σε ἐπεζήτησεν"},
    {"code": "44", "service": "orthros", "group": "ainoi_anatolika", "incipit": "Ἑβραῖοι συνέκλεισαν, ἐν τῷ τάφῳ τὴν ζωήν"},
    {"code": "45", "service": "liturgy", "group": "makarismoi", "incipit": "Ἀθετήσαντα Χριστέ, τὴν ἐντολήν σου"}
