    {"code": "13", "service": "vespers", "group": "aposticha", "incipit": "Φοβερὸς ὤφθης Κύριε"},
    {"code": "14", "service": "vespers", "group": "aposticha", "incipit": "Ὑπὸ τὴν σὴν Δέσποινα σκέπην"},
    {"code": "15", "service": "vespers", "group": "apolytikion", "incipit": "Κατέλυσας τῷ Σταυρῷ σου τὸν θάνατον"},
    {"code": "16", "service": "vespers", "group": "apolytikion", "incipit": "Ὡς τῆς ἡμῶν Ἀναστάσεως θησαύρισμα"},
    {"code": "17", "service": "orthros", "group": "kathismata", "incipit": "Ἡ Ζωὴ ἐν τῷ τάφῳ ἀνέκειτο"},
    {"code": "18", "service": "orthros", "group": "kathismata", "incipit": "Τῇ τριημέρῳ ταφῇ σου σκυλεύσας τὸν θάνατον"},
    {"code": "19", "service": "orthros", "group": "kathismata", "incipit": "Τὸν σταυρωθέντα ὑπὲρ ἡμῶν"},
    {"code": "20", "service": "orthros", "group": "kathismata", "incipit": "Ἐσφραγισμένου τοῦ μνήματος"},
    {"code": "21", "service": "orthros", "group": "kathismata", "incipit": "Ἐπὶ τὸ μνῆμα ἔδραμον Γυναῖκες"},
    {"code": "22", "service": "orthros", "group": "kathismata", "incipit": "Χαῖρε κεχαριτωμένη Θεοτόκε Παρθένε"},
    {"code": "23", "service": "orthros", "group": "ypakoe", "incipit": "Ὁ ἡμετέραν μορφὴν ἀναλαβών"},
    {"code": "24", "service": "orthros", "group": "anavathmoi", "incipit": "Τὴν αἰχμαλωσίαν Σιών"},
    {"code": "25", "service": "orthros", "group": "anavathmoi", "incipit": "Ἐὰν μὴ Κύριος οἰκοδομήσῃ οἶκον τὸν τῆς ψυχῆς"},
    {"code": "26", "service": "orthros", "group": "anavathmoi", "incipit": "Οἱ φοβούμενοι τὸν Κύριον"},
    {"code": "27", "service": "orthros", "group": "prokeimenon", "incipit": "Ἀνάστηθι, Κύριε ὁ Θεός μου"},
    {"code": "28", "service": "orthros", "group": "heirmoi", "incipit": "Νεύσει σοῦ πρὸς γεώδη"},
    {"code": "29", "service": "orthros", "group": "heirmoi", "incipit": "Ὁ κατ' ἀρχὰς τοὺς οὐρανούς"},
    {"code": "30", "service": "orthros", "group": "heirmoi", "incipit": "Ὁ πατρικοὺς κόλπους μὴ λιπών"},
    {"code": "31", "service": "orthros", "group": "heirmoi", "incipit": "Νὺξ ἀφεγγὴς τοῖς ἀπίστοις Χριστέ"},
    {"code": "32", "service": "orthros", "group": "heirmoi", "incipit": "Ναυτιῶν τῷ σάλῳ"},
    {"code": "33", "service": "orthros", "group": "heirmoi", "incipit": "Κάμινον Παῖδες, πυρίφλεκτον πάλαι"},
    {"code": "34", "service": "orthros", "group": "heirmoi", "incipit": "Ἄφλεκτος πυρὶ ἐν Σινᾷ προσομιλοῦσα"},
    {"code": "35", "service": "orthros", "group": "heirmoi", "incipit": "Μὴ τῆς φθορᾶς διαπείρᾳ κυοφορήσασα"},
    {"code": "36", "service": "orthros", "group": "kontakion", "incipit": "Οὐκ έτι τὸ κράτος τοῦ θανάτου"},
    {"code": "37", "service": "orthros", "group": "ainoi_anastasima", "incipit": "Ἀνέστη Χριστὸς ἐκ νεκρῶν"},
    {"code": "38", "service": "orthros", "group": "ainoi_anastasima", "incipit": "Ἀνάστασιν Χριστοῦ θεασάμενοι"},
    {"code": "39", "service": "orthros", "group": "ainoi_anastasima", "incipit": "Χριστοῦ τὴν Ἀνάστασιν"},
    {"code": "40", "service": "orthros", "group": "ainoi_anastasima", "incipit": "Τί ἀνταποδώσωμεν τῷ Κυρίῳ"},
    {"code": "41", "service": "orthros", "group": "ainoi_anatolika", "incipit": "Πύλας ᾍδου συνέτριψας Κύριε"},
    {"code": "42", "service": "orthros", "group": "ainoi_anatolika", "incipit": "Δεῦτε ἀγαλλιασώμεθα τῷ Κυρίῳ"},
    {"code": "43", "service": "orthros", "group": "ainoi_anatolika", "incipit": "Ἐξαστράπτων Ἄγγελος, ἐν τῷ λίθῳ ἐκάθητο τοῦ Ζωοδόχου"},
    {"code": "44", "service": "orthros", "group": "ainoi_anatolika", "incipit": "Τί ἀπεδοκιμάσατε τὸν λίθον τὸν ἀκρογωνιαῖον"},
    {"code": "45", "service": "liturgy", "group": "makarismoi", "incipit": "Ὡραῖος ἦν καὶ καλὸς εἰς βρῶσιν"}
   ],
