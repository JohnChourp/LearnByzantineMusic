    {"code": "38", "service": "orthros", "group": "ainoi_anastasima", "incipit": "Κύριε, τοὺς μοχλοὺς τοὺς αἰωνίους συντρίψας"},
    {"code": "39", "service": "orthros", "group": "ainoi_anastasima", "incipit": "Κύριε, αἱ Γυναῖκες ἔδραμον ἐπὶ τὸ μνῆμα"},
    {"code": "40", "service": "orthros", "group": "ainoi_anastasima", "incipit": "Κύριε, ὥσπερ ἐξῆλθες ἐσφραγισμένου τοῦ τάφου"},
    {"code": "41", "service": "orthros", "group": "ainoi_anatolika", "incipit": "Κύριε, ὁ Βασιλεὺς τῶν αἰώνων"},
    {"code": "42", "service": "orthros", "group": "ainoi_anatolika", "incipit": "Κύριε, τὰ ὑπερλάμποντά σου θαύματα τίς διηγήσεται"},
    {"code": "43", "service": "orthros", "group": "ainoi_anatolika", "incipit": "Μυροφόροι γυναῖκες, τὸν τάφον σου καταλαβοῦσαι"},
    {"code": "44", "service": "orthros", "group": "ainoi_anatolika", "incipit": "Τοῦ θεοδέγμονος τάφου"},
