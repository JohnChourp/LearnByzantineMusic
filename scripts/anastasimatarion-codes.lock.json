    {"code": "25", "service": "orthros", "group": "anavathmoi", "incipit": "Εἰς τὰ ὄρη ψυχὴ ἀρθῶμεν"},
    {"code": "26", "service": "orthros", "group": "anavathmoi", "incipit": "Ἐπὶ τοῖς εἰρηκόσι μοι"},
    {"code": "27", "service": "orthros", "group": "prokeimenon", "incipit": "Ἀνάστηθι Κύριε ὁ Θεός μου"},
    {"code": "28", "service": "orthros", "group": "heirmoi", "incipit": "Ἵππον καὶ ἀναβάτην"},
    {"code": "29", "service": "orthros", "group": "heirmoi", "incipit": "Ὁ πήξας ἐπ' οὐδενὸς τὴν γῆν τῇ προστάξει σου"},
    {"code": "30", "service": "orthros", "group": "heirmoi", "incipit": "Τὴν θείαν ἐννοήσας σου κένωσιν"},
