    {"code": "32", "service": "orthros", "group": "heirmoi", "incipit": "Μαινομένην κλύδωνι, ψυχοφθόρῳ Δεσπότα Χριστέ"},
    {"code": "33", "service": "orthros", "group": "heirmoi", "incipit": "Ὁ ὑπερυψούμενος, τῶν Πατέρων Κύριος"},
    {"code": "34", "service": "orthros", "group": "heirmoi", "incipit": "Σοὶ τῷ παντουργῷ"},
