    {"code": "20", "service": "orthros", "group": "kathismata", "incipit": "Ἀνέστης ὡς ἀθάνατος"},
    {"code": "21", "service": "orthros", "group": "kathismata", "incipit": "Ἐκ τῶν ἄνω κατελθών"},
    {"code": "22", "service": "orthros", "group": "kathismata", "incipit": "Κατεπλάγησαν Ἁγνή, πάντες Ἀγγέλων οἱ χοροί"},
    {"code": "23", "service": "orthros", "group": "ypakoe", "incipit": "Τὰ τῆς σῆς παραδόξου Ἐγέρσεως"},
    {"code": "24", "service": "orthros", "group": "anavathmoi", "incipit": "Ἐκ νεότητός μου πολλὰ πολεμεῖ με πάθη"},
    {"code": "25", "service": "orthros", "group": "anavathmoi", "incipit": "Ἐκέκραξά σοι Κύριε"},
    {"code": "26", "service": "orthros", "group": "anavathmoi", "incipit": "Ἡ καρδία μου πρὸς σὲ Λόγε ὑψωθήτω"},
    {"code": "27", "service": "orthros", "group": "prokeimenon", "incipit": "Ἀνάστα Κύριε, βοήθησον ἡμῖν"},
    {"code": "28", "service": "orthros", "group": "heirmoi", "incipit": "Θαλάσσης τὸ ἐρυθραῖον πέλαγος"},
    {"code": "29", "service": "orthros", "group": "heirmoi", "incipit": "Εὐφραίνεται ἐπὶ σοί"},
    {"code": "30", "service": "orthros", "group": "heirmoi", "incipit": "Ἐπαρθέντα σε ἰδοῦσα ἡ Ἐκκλησία"},
    {"code": "31", "service": "orthros", "group": "heirmoi", "incipit": "Σὺ Κύριέ μου φῶς"},
    {"code": "32", "service": "orthros", "group": "heirmoi", "incipit": "Θύσω σοι, μετὰ φωνῇς αἰνέσεως Κύριε"},
    {"code": "33", "service": "orthros", "group": "heirmoi", "incipit": "Ἐν τῇ καμίνῳ"},
    {"code": "34", "service": "orthros", "group": "heirmoi", "incipit": "Χεῖρας ἐκπετάσας Δανιήλ"},
    {"code": "35", "service": "orthros", "group": "heirmoi", "incipit": "Λίθος ἀχειρότμητος ὄρους"},
    {"code": "36", "service": "orthros", "group": "kontakion", "incipit": "Ὁ Σωτὴρ καὶ ῥύστης μου"},
    {"code": "37", "service": "orthros", "group": "ainoi_anastasima", "incipit": "Ὁ σταυρὸν ὑπομείνας καὶ θάνατον"},
    {"code": "38", "service": "orthros", "group": "ainoi_anastasima", "incipit": "Ἐν τῷ σταυρῷ σου Χριστέ"},
    {"code": "39", "service": "orthros", "group": "ainoi_anastasima", "incipit": "Τῷ σῷ Σταυρῷ Χριστὲ Σωτήρ"},
    {"code": "40", "service": "orthros", "group": "ainoi_anastasima", "incipit": "Τῶν Πατρικῶν σου κόλπων"},
    {"code": "41", "service": "orthros", "group": "ainoi_anatolika", "incipit": "Θάνατον κατεδέξω σαρκί"},
    {"code": "42", "service": "orthros", "group": "ainoi_anatolika", "incipit": "Πέτραι ἐσχίσθησαν Σωτήρ"},
    {"code": "43", "service": "orthros", "group": "ainoi_anatolika", "incipit": "Ἐπεθύμησαν Γυναῖκες, ἰδεῖν σου τὴν Ἀνάστασιν"},
    {"code": "44", "service": "orthros", "group": "ainoi_anatolika", "incipit": "Ποῦ ἐστιν Ἰησοῦς"},
    {"code": "45", "service": "liturgy", "group": "makarismoi", "incipit": "Διὰ ξύλου ὁ Ἀδάμ"}
