   "hymns": [
    {"code": "01", "service": "vespers", "group": "kekragarion", "incipit": "Κύριε ἐκέκραξα πρὸς σέ, εἰσάκουσόν μου"},
    {"code": "02", "service": "vespers", "group": "stichera_anastasima", "incipit": "Τὰς ἑσπερινὰς ἡμῶν εὐχάς"},
    {"code": "03", "service": "vespers", "group": "stichera_anastasima", "incipit": "Κυκλώσατε λαοὶ Σιών"},
    {"code": "04", "service": "vespers", "group": "stichera_anastasima", "incipit": "Δεῦτε λαοὶ ὑμνήσωμεν"},
    {"code": "05", "service": "vespers", "group": "anatolika", "incipit": "Εὐφράνθητε οὐρανοί, σαλπίσατε τὰ θεμέλια τῆς γῆς"},
    {"code": "06", "service": "vespers", "group": "anatolika", "incipit": "Τὸν σαρκὶ ἑκουσίως σταυρωθέντα δι’ ἡμᾶς"},
    {"code": "07", "service": "vespers", "group": "anatolika", "incipit": "Τῷ ζωοδόχῳ σου τάφῳ"},
    {"code": "08", "service": "vespers", "group": "anatolika", "incipit": "Τὸν τῷ Πατρὶ συνάναρχον"},
    {"code": "09", "service": "vespers", "group": "dogmatikon", "incipit": "Τὴν παγκόσμιον δόξαν"},
    {"code": "10", "service": "vespers", "group": "aposticha", "incipit": "Τῷ πάθει σου"},
    {"code": "11", "service": "vespers", "group": "aposticha", "incipit": "Ἀγαλλιάσθω ἡ κτίσις"},
    {"code": "12", "service": "vespers", "group": "aposticha", "incipit": "Βασιλεὺς ὑπάρχων οὐρανοῦ καὶ γῆς"},
    {"code": "13", "service": "vespers", "group": "aposticha", "incipit": "Γυναῖκες μυροφόροι μύρα φέρουσαι"},
    {"code": "14", "service": "vespers", "group": "aposticha", "incipit": "Ἰδοὺ πεπλήρωται ἡ τοῦ Ἡσαΐου πρόρρησις"},
    {"code": "15", "service": "vespers", "group": "apolytikion", "incipit": "Τοῦ λίθου σφραγισθέντος ὑπὸ τῶν Ἰουδαίων"},
    {"code": "16", "service": "vespers", "group": "apolytikion", "incipit": "Τοῦ Γαβριὴλ φθεγξαμένου σοι Παρθένε τὸ Χαῖρε"},
    {"code": "17", "service": "orthros", "group": "kathismata", "incipit": "Τὸν τάφον σου Σωτήρ"},
    {"code": "18", "service": "orthros", "group": "kathismata", "incipit": "Σταυρῷ προσηλωθείς, ἑκουσίως Οἰκτίρμον"},
    {"code": "19", "service": "orthros", "group": "kathismata", "incipit": "Μητέρα σε Θεοῦ"},
    {"code": "20", "service": "orthros", "group": "kathismata", "incipit": "Γυναῖκες πρὸς τὸ μνῆμα παρεγένοντο ὄρθριαι"},
    {"code": "21", "service": "orthros", "group": "kathismata", "incipit": "Ἐν τῷ Σταυρῷ προσηλωθεὶς ἡ ζωὴ τῶν ἁπάντων"},
    {"code": "22", "service": "orthros", "group": "kathismata", "incipit": "Μαρία τὸ σεπτόν"},
    {"code": "23", "service": "orthros", "group": "ypakoe", "incipit": "Ἡ τοῦ Λῃστοῦ μετάνοια"},
    {"code": "24", "service": "orthros", "group": "anavathmoi", "incipit": "Ἐν τῷ θλίβεσθαί με"},
    {"code": "25", "service": "orthros", "group": "anavathmoi", "incipit": "Εἰς τὰ ὄρη τῶν σῶν"},
    {"code": "26", "service": "orthros", "group": "anavathmoi", "incipit": "Ἐπὶ τοῖς εἰρηκόσι μοι ὁδεύσωμεν εἷς τὰς αὐλὰς τοῦ Κυρίου"},
    {"code": "27", "service": "orthros", "group": "prokeimenon", "incipit": "Νῦν ἀναστήσομαι λέγει Κύριος"},
    {"code": "28", "service": "orthros", "group": "heirmoi", "incipit": "Σοῦ ἡ τροπαιοῦχος δεξιά"},
    {"code": "29", "service": "orthros", "group": "heirmoi", "incipit": "Ὁ μόνος εἰδὼς τῆς τῶν βροτῶν"},
    {"code": "30", "service": "orthros", "group": "heirmoi", "incipit": "Ὄρος σε τῇ χάριτι"},
    {"code": "31", "service": "orthros", "group": "heirmoi", "incipit": "Ὁ φωτίσας τῇ ἐλλάμψει"},
    {"code": "32", "service": "orthros", "group": "heirmoi", "incipit": "Ἐκύκλωσεν ἡμᾶς ἐσχάτη ἄβυσσος"},
    {"code": "33", "service": "orthros", "group": "heirmoi", "incipit": "Σὲ νοητήν, Θεοτόκε κάμινον"},
    {"code": "34", "service": "orthros", "group": "heirmoi", "incipit": "Ἐν καμίνῳ Παῖδες Ἰσραήλ"},
    {"code": "35", "service": "orthros", "group": "heirmoi", "incipit": "Τύπον τῆς ἁγνῆς λοχείας σου"},
    {"code": "36", "service": "orthros", "group": "kontakion", "incipit": "Ἐξανέστης ὡς Θεός"},
    {"code": "37", "service": "orthros", "group": "ainoi_anastasima", "incipit": "Ὑμνοῦμέν σου Χριστέ"},
    {"code": "38", "service": "orthros", "group": "ainoi_anastasima", "incipit": "Ὁ Σταυρὸν ὑπομείνας"},
    {"code": "39", "service": "orthros", "group": "ainoi_anastasima", "incipit": "Ὁ τὸν ᾅδην σκυλεύσας"},
    {"code": "40", "service": "orthros", "group": "ainoi_anastasima", "incipit": "Τὴν θεοπρεπῆ σου συγκατάβασιν δοξάζοντες"},
    {"code": "41", "service": "orthros", "group": "ainoi_anatolika", "incipit": "Ὅτε προσηλώθης τῷ ξύλῳ τοῦ Σταυροῦ"},
    {"code": "42", "service": "orthros", "group": "ainoi_anatolika", "incipit": "Ὀδυρόμεναι μετὰ σπουδῆς"},
    {"code": "43", "service": "orthros", "group": "ainoi_anatolika", "incipit": "Τὴν τῶν παθῶν θείαν μωλώπωσιν"},
    {"code": "44", "service": "orthros", "group": "ainoi_anatolika", "incipit": "Τὸ φιλοτάραχον γένος τῶν Ἰουδαίων"},
    {"code": "45", "service": "liturgy", "group": "makarismoi", "incipit": "Διὰ βρώσεως ἐξήγαγε"}
   ],
