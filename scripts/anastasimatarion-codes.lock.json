    {"code": "02", "service": "vespers", "group": "stichera_anastasima", "incipit": "Διὰ τοῦ τιμίου σου Σταυροῦ Χριστέ"},
    {"code": "03", "service": "vespers", "group": "stichera_anastasima", "incipit": "Ὁ τὴν Ἀνάστασιν διδοὺς τῷ γένει τῶν ἀνθρώπων"},
    {"code": "04", "service": "vespers", "group": "stichera_anastasima", "incipit": "Μέγα θαῦμα! ὁ τῶν ἀοράτων Κτίστης"},
    {"code": "05", "service": "vespers", "group": "anatolika", "incipit": "Ἑσπερινὴν προσκύνησιν προσφέρομέν σοι τῷ ἀνεσπέρῳ Φωτί"},
    {"code": "06", "service": "vespers", "group": "anatolika", "incipit": "Τὸν ἀρχηγὸν τῆς σωτηρίας ἡμῶν"},
