<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/first_mode_theory_page_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <Button
            android:id="@+id/theory_topic_back_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/first_mode_theory_callout_bg"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:text="@string/theory_topic_back_button"
            android:textAllCaps="false"
            android:textColor="@color/first_mode_theory_accent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/first_mode_theory_hero_bg"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/theory_topic_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/first_mode_theory_text_primary"
                android:textSize="28sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/theory_topic_body_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/first_mode_theory_card_bg"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/theory_topic_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/first_mode_theory_text_primary"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
