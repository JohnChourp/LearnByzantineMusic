<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/eight_modes_page_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="18dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/eight_modes_page_title"
            android:textColor="#202124"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/eight_modes_page_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/eight_modes_page_subtitle"
            android:textColor="#5F6368"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/mode_selector_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/eight_modes_selector_card_bg"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/eight_modes_selector_label"
                android:textColor="#0D47A1"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/eight_modes_mode_selector_hint"
                android:textColor="#53636F"
                android:textSize="13sp" />

            <Spinner
                android:id="@+id/mode_selector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/eight_modes_spinner_bg"
                android:dropDownWidth="match_parent"
                android:minHeight="54dp"
                android:popupBackground="@drawable/eight_modes_spinner_popup_bg"
                android:paddingStart="2dp"
                android:paddingEnd="2dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/timbre_selector_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/eight_modes_timbre_card_bg"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/eight_modes_timbre_selector_label"
                android:textColor="#6A1B9A"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/timbre_selector_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/eight_modes_timbre_selector_hint"
                android:textColor="#64515D"
                android:textSize="13sp" />

            <Spinner
                android:id="@+id/timbre_selector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/eight_modes_spinner_bg"
                android:dropDownWidth="match_parent"
                android:minHeight="54dp"
                android:popupBackground="@drawable/eight_modes_spinner_popup_bg"
                android:paddingStart="2dp"
                android:paddingEnd="2dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/selected_mode_summary_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/eight_modes_summary_card_bg"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/eight_modes_current_mode_title"
                android:textColor="#334155"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/selected_mode_apichima_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="#111827"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/selected_mode_apichima_phthongs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:textColor="#374151"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/selected_mode_apichima_syllables"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textColor="#4B5563"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/selected_mode_apichima_alternatives"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textColor="#4B5563"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/selected_mode_apichima_alternative_phthongs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textColor="#4B5563"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/selected_mode_apichima_alternative_syllables"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textColor="#4B5563"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/selected_mode_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="2dp"
                android:textColor="#374151"
                android:textSize="15sp" />

            <Button
                android:id="@+id/selected_mode_theory_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/eight_modes_primary_button_bg"
                android:paddingVertical="11dp"
                android:text="@string/eight_modes_first_mode_theory_cta"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/base_shift_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/eight_modes_base_shift_card_bg"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/base_shift_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/eight_modes_base_shift_title"
                android:textColor="#334155"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/base_shift_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/eight_modes_base_shift_hint"
                android:textColor="#4B5563"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/base_shift_value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/eight_modes_base_shift_default_value"
                    android:textColor="#111827"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/base_shift_reset_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/eight_modes_secondary_button_bg"
                    android:minHeight="0dp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:text="@string/eight_modes_base_shift_reset"
                    android:textAllCaps="false"
                    android:textColor="#1565C0" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/base_shift_seekbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/eight_modes_base_shift_lower"
                    android:textColor="#5F6368"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/eight_modes_base_shift_higher"
                    android:textColor="#5F6368"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/touch_hint_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/eight_modes_hint_bg"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp"
            android:textColor="#405064"
            android:textSize="15sp" />

        <com.johnchourp.learnbyzantinemusic.modes.ScaleDiagramView
            android:id="@+id/ascending_diagram_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp" />
    </LinearLayout>
</ScrollView>
