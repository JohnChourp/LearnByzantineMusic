<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- A recording in progress, and recordings the folder could not take (ClickUp 869f5x26x):
             raw WAV audio that stays on this device. A few minutes of it exceed the 25 MB backup
             quota, and a backup over quota is not made at all, the notes included. -->
        <exclude domain="file" path="recordings_capture" />
        <exclude domain="file" path="recordings_pending" />
    </cloud-backup>
    <!--
    <device-transfer>
        <include .../>
        <exclude .../>
    </device-transfer>
    -->
</data-extraction-rules>