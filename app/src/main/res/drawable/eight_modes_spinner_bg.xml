<?xml version="1.0" encoding="utf-8"?>
<!--
  The search field of the pages menu (EightModesNavigation). Its fill is the night-aware card colour,
  not a literal white: the text typed into it follows the theme, and on a white fill the dark theme's
  text measured 1.19:1 (ClickUp 869f5x286). PagesMenuContrastTest reads this file.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="@color/first_mode_theory_card_bg" />
    <stroke
        android:width="1dp"
        android:color="#97B9E8" />
    <corners android:radius="8dp" />
</shape>
