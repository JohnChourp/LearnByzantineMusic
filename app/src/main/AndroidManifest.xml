<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- A recording keeps going with the screen off (ClickUp 869f5x273): RecordingService, a
         foreground service of type microphone, with its «Ηχογράφηση…» notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The metronome's vibration (ClickUp 869f5x2d7). A normal permission: granted at install,
         no prompt. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/_0"
        android:label="@string/app_name"
        android:roundIcon="@drawable/_0"
        android:supportsRtl="true"
        android:theme="@style/Theme.LearnByzantineMusic"
        tools:targetApi="31">
        <activity
            android:name=".modes.EightModesActivity"
            android:exported="false"
            android:label="@string/title_activity_eight_modes"
            android:theme="@style/Theme.LearnByzantineMusic" />
        <activity
            android:name=".modes.ModeTheoryActivity"
            android:exported="false"
            android:label="@string/title_activity_mode_theory"
            android:theme="@style/Theme.LearnByzantineMusic" />
        <activity
            android:name=".modes.TheoryTopicActivity"
            android:exported="false"
            android:label="@string/title_activity_theory_topic"
            android:theme="@style/Theme.LearnByzantineMusic" />
        <activity
            android:name=".calendar.WeeklyModeCalendarActivity"
            android:exported="false"
            android:label="@string/title_activity_weekly_mode_calendar"
            android:theme="@style/Theme.LearnByzantineMusic" />
        <activity
            android:name=".calendar.ReadingTextActivity"
            android:exported="false"
            android:label="@string/title_activity_reading_text"
            android:theme="@style/Theme.LearnByzantineMusic" />
        <activity
            android:name=".recordings.RecordingsActivity"
            android:exported="false"
            android:label="@string/title_activity_recordings"
            android:theme="@style/Theme.LearnByzantineMusic" />
        <activity
            android:name=".recordings.analysis.RecordingAnalysisActivity"
            android:exported="false"
            android:label="@string/title_activity_recording_analysis"
            android:theme="@style/Theme.LearnByzantineMusic" />
        <activity
            android:name=".recordings.RecordingsManagerActivity"
            android:exported="false"
            android:label="@string/recordings_manage_open"
            android:theme="@style/Theme.LearnByzantineMusic" />
        <activity
            android:name=".notes.NotesActivity"
            android:exported="false"
            android:label="@string/title_activity_notes"
            android:theme="@style/Theme.LearnByzantineMusic" />
        <activity
            android:name=".summary_theory.Testimonies"
            android:exported="false"
            android:label="@string/title_activity_testimonies"
            android:theme="@style/Theme.LearnByzantineMusic" />
        <activity
            android:name=".summary_theory.Time"
            android:exported="false"
            android:label="@string/title_activity_time"
            android:theme="@style/Theme.LearnByzantineMusic" />
        <activity
            android:name=".summary_theory.Quality"
            android:exported="false"
            android:label="@string/title_activity_quality"
            android:theme="@style/Theme.LearnByzantineMusic" />
        <activity
            android:name=".summary_theory.Descents"
            android:exported="false"
            android:label="@string/title_activity_descents"
            android:theme="@style/Theme.LearnByzantineMusic" />
        <activity
            android:name=".summary_theory.Ascents"
            android:exported="false"
            android:label="@string/title_activity_ascents"
            android:theme="@style/Theme.LearnByzantineMusic" />
        <activity
            android:name=".lessons.ClimbingCompositions"
            android:exported="false"
            android:label="@string/title_activity_lesson3"
            android:theme="@style/Theme.LearnByzantineMusic" />
        <activity
            android:name=".lessons.Duotrioquatro"
            android:exported="false"
            android:label="@string/title_activity_lesson2"
            android:theme="@style/Theme.LearnByzantineMusic" />
        <activity
            android:name=".lessons.PhthongsNames"
            android:exported="false"
            android:label="@string/title_activity_phthongs_names"
            android:theme="@style/Theme.LearnByzantineMusic" />
        <activity
            android:name=".anastasimatarion.AnastasimatarionActivity"
            android:exported="false"
            android:label="@string/title_activity_anastasimatarion"
            android:theme="@style/Theme.LearnByzantineMusic" />
        <activity
            android:name=".anastasimatarion.HymnActivity"
            android:exported="false"
            android:label="@string/title_activity_hymn"
            android:theme="@style/Theme.LearnByzantineMusic" />
        <!-- «Πεντάλεπτο της ημέρας» and its history (ClickUp 869f5x2dy). -->
        <activity
            android:name=".practice.DailyPracticeActivity"
            android:exported="false"
            android:label="@string/practice_daily_title"
            android:theme="@style/Theme.LearnByzantineMusic" />
        <activity
            android:name=".practice.PracticeHistoryActivity"
            android:exported="false"
            android:label="@string/practice_open_history"
            android:theme="@style/Theme.LearnByzantineMusic" />
        <activity
            android:name=".trainer.MelodyTrainerActivity"
            android:exported="false"
            android:label="@string/title_activity_melody_trainer"
            android:theme="@style/Theme.LearnByzantineMusic" />
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/title_activity_settings"
            android:theme="@style/Theme.LearnByzantineMusic" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.LearnByzantineMusic">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Not stopWithTask: swiping the app away must reach onTaskRemoved, which stops and saves. -->
        <service
            android:name=".recordings.session.RecordingService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
